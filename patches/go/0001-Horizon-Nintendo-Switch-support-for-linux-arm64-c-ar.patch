diff --git a/src/runtime/nx_linux_arm64.go b/src/runtime/nx_linux_arm64.go
new file mode 100644
index 00000000..295a5b78
--- /dev/null
+++ b/src/runtime/nx_linux_arm64.go
@@ -0,0 +1,22 @@
+// Nintendo Switch (Horizon) port support.
+//
+// The Go runtime is built as GOOS=linux GOARCH=arm64. Every Linux system
+// call instruction (SVC) is redirected to _nx_svc, which forwards the call
+// to a C emulation layer on top of libnx (runtime/cgo/gcc_horizon.c).
+
+//go:build linux && arm64
+
+package runtime
+
+import "unsafe"
+
+// _nx_syscall is the C emulation entry point, filled in by runtime/cgo.
+//
+//go:linkname _nx_syscall _nx_syscall
+var _nx_syscall unsafe.Pointer
+
+// _nx_argv points to a static argv/envp/auxv block, filled in by runtime/cgo.
+// Horizon does not pass any arguments to global constructors.
+//
+//go:linkname _nx_argv _nx_argv
+var _nx_argv unsafe.Pointer
diff --git a/src/runtime/nx_linux_arm64.s b/src/runtime/nx_linux_arm64.s
new file mode 100644
index 00000000..1e63d880
--- /dev/null
+++ b/src/runtime/nx_linux_arm64.s
@@ -0,0 +1,46 @@
+// Nintendo Switch (Horizon) port support. See nx_linux_arm64.go.
+
+#include "go_asm.h"
+#include "textflag.h"
+
+// _nx_svc emulates the Linux SVC instruction.
+// In: R8 = syscall number, R0-R5 = arguments. Out: R0 = result or -errno.
+// Every other general purpose register is preserved, like a real SVC.
+// The caller saves LR in R16 (see the SVC macro in sys_linux_arm64.s).
+TEXT _nx_svc(SB),NOSPLIT,$224-0
+	// args block: [nr, a0, a1, a2, a3, a4, a5] at 40(RSP)
+	MOVD	R8, 40(RSP)
+	MOVD	R0, 48(RSP)
+	MOVD	R1, 56(RSP)
+	MOVD	R2, 64(RSP)
+	MOVD	R3, 72(RSP)
+	MOVD	R4, 80(RSP)
+	MOVD	R5, 88(RSP)
+	// save R1-R17 at 96(RSP)
+	STP	(R1, R2), 96(RSP)
+	STP	(R3, R4), 112(RSP)
+	STP	(R5, R6), 128(RSP)
+	STP	(R7, R8), 144(RSP)
+	STP	(R9, R10), 160(RSP)
+	STP	(R11, R12), 176(RSP)
+	STP	(R13, R14), 192(RSP)
+	STP	(R15, R16), 208(RSP)
+	MOVD	R17, 224(RSP)
+
+	MOVD	_nx_syscall(SB), R9
+	MOVD	R9, 8(RSP)
+	MOVD	$40(RSP), R9
+	MOVD	R9, 16(RSP)
+	BL	runtime·asmcgocall(SB)
+	MOVD	40(RSP), R0
+
+	LDP	96(RSP), (R1, R2)
+	LDP	112(RSP), (R3, R4)
+	LDP	128(RSP), (R5, R6)
+	LDP	144(RSP), (R7, R8)
+	LDP	160(RSP), (R9, R10)
+	LDP	176(RSP), (R11, R12)
+	LDP	192(RSP), (R13, R14)
+	LDP	208(RSP), (R15, R16)
+	MOVD	224(RSP), R17
+	RET
