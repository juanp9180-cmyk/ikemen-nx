--- /dev/null
+++ b/src/util_nx.go
@@ -0,0 +1,90 @@
+//go:build nx
+
+package main
+
+/*
+#include <EGL/egl.h>
+#include <stdlib.h>
+*/
+import "C"
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"runtime"
+	"unsafe"
+)
+
+// Main entry point, called from the C main() of the Switch homebrew.
+// baseDir is the folder holding the engine data, e.g. "sdmc:/switch/ikemen".
+//
+//export GoMain
+func GoMain(baseDir *C.char) {
+	runtime.LockOSThread()
+	sys.baseDir = C.GoString(baseDir)
+	os.Args = []string{"ikemen-go"}
+	realMain()
+}
+
+// Log writer implementation. Stderr is copied to go_stdout.log next to the
+// executable by the Horizon runtime layer.
+func NewLogWriter() io.Writer {
+	return os.Stderr
+}
+
+// There are no desktop dialogs on the Switch: messages go to the log.
+func ShowInfoDialog(message, title string) {
+	fmt.Fprintf(os.Stderr, "INFO [%s]: %s\n", title, message)
+}
+
+func ShowErrorDialog(message string) {
+	fmt.Fprintf(os.Stderr, "I.K.E.M.E.N Error: %s\n", message)
+}
+
+// No interactive dialog here, so never retry
+func ShowRetryDialog(message string) bool {
+	return false
+}
+
+// TTF font loading. There are no system fonts: only the engine's own.
+func LoadFntTtf(f *Fnt, fontfile string, filename string, height int32) {
+	fileDir := SearchFile(filename, []string{fontfile, sys.motif.Def, "", "data/"}, "font/")
+	if FileExist(fileDir) == "" {
+		panic(fmt.Errorf("failed to find ttf font %v", fileDir))
+	}
+	if height == -1 {
+		height = int32(f.Size[1])
+	} else {
+		f.Size[1] = uint16(height)
+	}
+	ttf, err := gfxFont.LoadFont(fileDir, height, int(sys.gameWidth), int(sys.gameHeight))
+	if err != nil {
+		panic(fmt.Errorf("failed to load ttf font %v: %w", fileDir, err))
+	}
+	f.ttf = ttf.(Font)
+
+	// Create Ttf dummy palettes
+	f.palettes = make([][256]uint32, 1)
+	for i := 0; i < 256; i++ {
+		f.palettes[0][i] = 0
+	}
+}
+
+func eglGetProcAddress(name string) unsafe.Pointer {
+	cname := C.CString(name)
+	defer C.free(unsafe.Pointer(cname))
+	return unsafe.Pointer(C.eglGetProcAddress(cname))
+}
+
+// The Switch GPU driver (Mesa nouveau) offers OpenGL ES 3.2 only.
+func selectRenderer(cfgVal string) (Renderer, FontRenderer) {
+	if cfgVal != "OpenGL ES 3.2" {
+		fmt.Printf("RenderMode '%s' is not available on Switch, using OpenGL ES 3.2.\n", cfgVal)
+	}
+	return &Renderer_GLES32{}, &FontRenderer_GLES32{}
+}
+
+func Logcat(s string) {
+	fmt.Println(s)
+}
