--- /dev/null
+++ b/src/platform_nx.go
@@ -0,0 +1,31 @@
+//go:build nx
+
+package main
+
+import (
+	"regexp"
+	"strings"
+)
+
+// isNX reports whether this is the Nintendo Switch (Horizon) build. The
+// Switch follows the Android code paths: OpenGL ES 3.2, fullscreen window,
+// no window icon or desktop dialogs.
+const isNX = true
+
+// gsInMacro matches uses of the GS_IN(name) shader macro.
+var gsInMacro = regexp.MustCompile(`GS_IN\((\w+)\)`)
+
+// expandGSIn expands the GS_IN(name) macro to nameIn. Mesa follows the GLSL
+// ES spec strictly and rejects the ## token pasting the macro is built on.
+func expandGSIn(src string) string {
+	if !strings.Contains(src, "GS_IN") {
+		return src
+	}
+	lines := strings.Split(src, "\n")
+	for i, l := range lines {
+		if strings.HasPrefix(strings.TrimSpace(l), "#define GS_IN(") {
+			lines[i] = ""
+		}
+	}
+	return gsInMacro.ReplaceAllString(strings.Join(lines, "\n"), "${1}In")
+}
