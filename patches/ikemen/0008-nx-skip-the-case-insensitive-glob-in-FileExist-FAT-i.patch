From 5e4ae112803876e3a5379341ef93c7389a19fdf0 Mon Sep 17 00:00:00 2001
From: Ikemen NX contributors <ikemen-nx@users.noreply.github.com>
Date: Mon, 12 Oct 2026 10:11:10 -0300
Subject: [PATCH 08/10] nx: skip the case-insensitive glob in FileExist (FAT is
 case-insensitive)

---
 src/common.go | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/common.go b/src/common.go
index d87c335..a8679fe 100644
--- a/src/common.go
+++ b/src/common.go
@@ -513,6 +513,12 @@ func FileExist(filename string) string {
 		}
 		return filepath.ToSlash(filename)
 	}
+	// The Switch SD card (FAT) is already case-insensitive, so a failed stat
+	// means the file is missing. The case-insensitive glob below would list
+	// whole directories, which is very slow there with thousands of chars.
+	if isNX {
+		return ""
+	}
 	var pattern string
 	for _, r := range filename {
 		if r >= 'A' && r <= 'Z' || r >= 'a' && r <= 'z' {
-- 
