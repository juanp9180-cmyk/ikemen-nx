 		if (isRgba) {
@@ -100,7 +109,11 @@ void main(void) {
 			#if __VERSION__ >= 450
 				c = COMPAT_TEXTURE(pal, vec2(palUV[0]+palUV[2]*c.r*0.9966, palUV[1]));
 			#else
-				c = COMPAT_TEXTURE(pal, vec2(c.r*0.9966, 0.5));
+				#ifdef GL_ES
+					c = COMPAT_TEXTURE(pal, vec2(c.r*0.9966, palV));
