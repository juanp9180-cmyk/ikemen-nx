diff --git a/src/render_gles32_atlas.go b/src/render_gles32_atlas.go
new file mode 100644
index 0000000..d4a1780
--- /dev/null
+++ b/src/render_gles32_atlas.go
@@ -0,0 +1,220 @@
+//go:build android || nx
+
+package main
+
+import (
+	"fmt"
+	"runtime"
+	"unsafe"
+
+	gl "github.com/leonkasovan/gl/v3.2/gles2"
+)
+
+// Texture atlases for the Switch.
+//
+// Ikemen creates one GPU texture per sprite and per palette. On the Switch
+// every texture is a separate GPU (nvmap) allocation, and the driver fails
+// with GL_OUT_OF_MEMORY at around 3000 of them, which a Turns or Simul match
+// with several characters easily exceeds: sprites past the limit are simply
+// not drawn. Small nearest-filtered textures are packed into shared pages
+// instead; the sprite shader maps sprite UVs into the page with the texRect
+// uniform and selects the palette row with palV.
+
+type nxAtlasShelf struct{ y, h, x int32 }
+
+type nxAtlasPage struct {
+	handle  uint32
+	serial  uint64
+	set     *nxAtlasSet
+	shelves []nxAtlasShelf
+	nextY   int32
+	refs    int
+}
+
+type nxAtlasSet struct {
+	name   string
+	depth  int32 // 8 = R8, 32 = RGBA8
+	w, h   int32 // page size
+	pad    int32 // transparent border around each entry
+	maxDim int32 // largest entry side accepted
+	pages  []*nxAtlasPage
+}
+
+var (
+	nxAtlas8   = &nxAtlasSet{name: "R8", depth: 8, w: 2048, h: 2048, pad: 1, maxDim: 1024}
+	nxAtlas32  = &nxAtlasSet{name: "RGBA", depth: 32, w: 2048, h: 2048, pad: 1, maxDim: 512}
+	nxAtlasPal = &nxAtlasSet{name: "PAL", depth: 32, w: 256, h: 1024, pad: 0, maxDim: 256}
+)
+
+// nxAtlasFor picks the atlas for a texture, or nil to use its own texture.
+func nxAtlasFor(width, height, depth int32, filter bool) *nxAtlasSet {
+	if !isNX || filter || width <= 0 || height <= 0 {
+		return nil
+	}
+	switch {
+	case depth == 32 && width == 256 && height == 1:
+		return nxAtlasPal
+	case depth == 8 && width <= nxAtlas8.maxDim && height <= nxAtlas8.maxDim:
+		return nxAtlas8
+	case depth == 32 && width <= nxAtlas32.maxDim && height <= nxAtlas32.maxDim:
+		return nxAtlas32
+	}
+	return nil
+}
+
+func (s *nxAtlasSet) format() (internal int32, format uint32) {
+	if s.depth == 8 {
+		return gl.R8, gl.RED
+	}
+	return gl.RGBA8, gl.RGBA
+}
+
+func (s *nxAtlasSet) newPage() *nxAtlasPage {
+	r := gfx.(*Renderer_GLES32)
+	var h uint32
+	gl.GenTextures(1, &h)
+	textureSerialNumber++
+	p := &nxAtlasPage{handle: h, serial: textureSerialNumber, set: s}
+	internal, format := s.format()
+	// Start from a cleared page so borders read as transparent.
+	zero := make([]byte, int(s.w)*int(s.h)*int(s.depth/8))
+	gl.ActiveTexture(gl.TEXTURE0 + uint32(r.uploadUnit))
+	gl.BindTexture(gl.TEXTURE_2D, h)
+	gl.PixelStorei(gl.UNPACK_ALIGNMENT, 1)
+	gl.PixelStorei(gl.UNPACK_ROW_LENGTH, 0)
+	gl.TexImage2D(gl.TEXTURE_2D, 0, internal, s.w, s.h, 0, format, gl.UNSIGNED_BYTE, unsafe.Pointer(&zero[0]))
+	gl.TexParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST)
+	gl.TexParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST)
+	gl.TexParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE)
+	gl.TexParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
+	s.pages = append(s.pages, p)
+	return p
+}
+
+// place finds room for a w x h block (padding included) using shelves.
+func (p *nxAtlasPage) place(w, h int32) (int32, int32, bool) {
+	s := p.set
+	best := -1
+	for i := range p.shelves {
+		sh := &p.shelves[i]
+		// Fit in an existing shelf if it is not much taller than needed.
+		if h <= sh.h && sh.h <= h+h/2+8 && sh.x+w <= s.w {
+			if best < 0 || sh.h < p.shelves[best].h {
+				best = i
+			}
+		}
+	}
+	if best >= 0 {
+		sh := &p.shelves[best]
+		x := sh.x
+		sh.x += w
+		return x, sh.y, true
+	}
+	if p.nextY+h > s.h {
+		return 0, 0, false
+	}
+	y := p.nextY
+	p.shelves = append(p.shelves, nxAtlasShelf{y: y, h: h, x: w})
+	p.nextY += h
+	return 0, y, true
+}
+
+// alloc reserves room for a width x height entry; x, y exclude the padding.
+func (s *nxAtlasSet) alloc(width, height int32) (*nxAtlasPage, int32, int32) {
+	w, h := width+2*s.pad, height+2*s.pad
+	for _, p := range s.pages {
+		if x, y, ok := p.place(w, h); ok {
+			p.refs++
+			return p, x + s.pad, y + s.pad
+		}
+	}
+	p := s.newPage()
+	x, y, _ := p.place(w, h)
+	p.refs++
+	if len(s.pages)%8 == 0 {
+		Logcat(fmt.Sprintf("GLES: %s atlas pages: %d", s.name, len(s.pages)))
+	}
+	return p, x + s.pad, y + s.pad
+}
+
+// release frees one entry; an empty page is reused from scratch.
+func (p *nxAtlasPage) release() {
+	p.refs--
+	if p.refs <= 0 {
+		p.refs = 0
+		p.shelves = p.shelves[:0]
+		p.nextY = 0
+	}
+}
+
+// newAtlasTexture returns a texture living in an atlas page, or nil.
+func (r *Renderer_GLES32) newAtlasTexture(width, height, depth int32, filter bool) *Texture_GLES32 {
+	s := nxAtlasFor(width, height, depth, filter)
+	if s == nil {
+		return nil
+	}
+	page, x, y := s.alloc(width, height)
+	t := &Texture_GLES32{
+		width:  width,
+		height: height,
+		depth:  depth,
+		filter: filter,
+		handle: page.handle,
+		serial: page.serial,
+		page:   page,
+		ax:     x,
+		ay:     y,
+	}
+	runtime.SetFinalizer(t, func(t *Texture_GLES32) {
+		sys.mainThreadTask <- func() {
+			t.page.release()
+		}
+	})
+	return t
+}
+
+// uploadAtlas writes the texture's pixels (with a cleared border) into its
+// page, binding the page on the reserved upload unit.
+func (t *Texture_GLES32) uploadAtlas(data []byte) {
+	s := t.page.set
+	bpp := int(s.depth / 8)
+	_, format := s.format()
+	pad := s.pad
+	w, h := t.width+2*pad, t.height+2*pad
+	buf := data
+	if pad > 0 {
+		buf = make([]byte, int(w)*int(h)*bpp)
+		if data != nil {
+			row := int(t.width) * bpp
+			for yy := 0; yy < int(t.height) && (yy+1)*row <= len(data); yy++ {
+				copy(buf[((yy+int(pad))*int(w)+int(pad))*bpp:], data[yy*row:(yy+1)*row])
+			}
+		}
+	} else if buf == nil {
+		buf = make([]byte, int(w)*int(h)*bpp)
+	}
+	r := gfx.(*Renderer_GLES32)
+	gl.ActiveTexture(gl.TEXTURE0 + uint32(r.uploadUnit))
+	gl.BindTexture(gl.TEXTURE_2D, t.handle)
+	gl.PixelStorei(gl.UNPACK_ALIGNMENT, 1)
+	gl.PixelStorei(gl.UNPACK_ROW_LENGTH, 0)
+	gl.TexSubImage2D(gl.TEXTURE_2D, 0, t.ax-pad, t.ay-pad, w, h, format, gl.UNSIGNED_BYTE, unsafe.Pointer(&buf[0]))
+}
+
+// texRect is the sprite's area in its texture as (u0, v0, du, dv).
+func (t *Texture_GLES32) texRect() (float32, float32, float32, float32) {
+	if t.page == nil {
+		return 0, 0, 1, 1
+	}
+	s := t.page.set
+	return float32(t.ax) / float32(s.w), float32(t.ay) / float32(s.h),
+		float32(t.width) / float32(s.w), float32(t.height) / float32(s.h)
+}
+
+// palV is the v coordinate of the palette row to sample.
+func (t *Texture_GLES32) palV() float32 {
+	if t.page == nil {
+		return 0.5
+	}
+	return (float32(t.ay) + 0.5) / float32(t.page.set.h)
+}
