+// "-nxautokeys" in args.txt presses P1's A key (keyboard z) every 2.5 s
+// from 25 s on, to walk menus, select and VS screens in the emulator,
+// whose own key injection does not reach the game.
+var nxAutoKeysOn = -1
+var nxAutoKeysStart time.Time
+var nxAutoKeysDown bool
+var nxAutoKeysLeft = -1 // "-nxautokeys=N" stops after N presses
+
+func nxAutoKeys() {
+	C.nx_hb_frames++
+	if nxAutoKeysOn < 0 {
+		nxAutoKeysOn = 0
+		for _, a := range os.Args {
+			if a == "-nxautokeys" || strings.HasPrefix(a, "-nxautokeys=") {
+				nxAutoKeysOn = 1
+				nxAutoKeysStart = time.Now()
+				if n, err := strconv.Atoi(strings.TrimPrefix(a, "-nxautokeys=")); err == nil {
+					nxAutoKeysLeft = n
+				}
+			}
+		}
+	}
+	if nxAutoKeysOn == 0 {
+		return
+	}
+	t := time.Since(nxAutoKeysStart)
+	if t < 25*time.Second {
+		return
+	}
+	phase := t % (2500 * time.Millisecond)
+	if phase < 200*time.Millisecond {
+		if !nxAutoKeysDown && nxAutoKeysLeft != 0 {
+			nxAutoKeysDown = true
+			if nxAutoKeysLeft > 0 {
+				nxAutoKeysLeft--
+			}
+			fmt.Fprintf(os.Stderr, "nx: autokey z at %v\n", t.Round(time.Second))
+			OnKeyPressed(sdl.K_z, 0)
+		}
+	} else if nxAutoKeysDown {
+		nxAutoKeysDown = false
+		OnKeyReleased(sdl.K_z, 0)
+	}
+}
+
+// nxTrace logs a timestamped step, for locating hangs on the console.
+func nxTrace(format string, a ...interface{}) {
+	fmt.Fprintf(os.Stderr, "nx %v: %s\n", time.Since(nxStart).Round(time.Millisecond), fmt.Sprintf(format, a...))
+}
+
+var nxStart = time.Now()
+
+// "-nxconsolelog" in args.txt also copies Ikemen's debug console (load
+// warnings, char errors) to the log. Off by default: it is thousands of
+// lines while loading characters, each one a write to the SD card.
+var nxConsoleLog bool
+
+// nxStallWatch feeds the C watchdog, logs the frame rate every 10 s, and
+// when the main loop draws under 5 frames per second for 10 s (stuck or
+// crawling), writes every goroutine's stack to the log, at most 3 times.
+func nxStallWatch() {
+	last, slow, dumps := uint32(0), 0, 0
+	for i := 1; ; i++ {
+		time.Sleep(time.Second)
+		C.nx_hb_go++
+		f := uint32(C.nx_hb_frames)
+		fps := f - last
+		last = f
+		if i%10 == 0 {
+			nxTrace("fps=%d frames=%d", fps, f)
+		}
+		if fps >= 5 {
+			slow = 0
+			continue
+		}
+		if slow++; slow == 10 && dumps < 6 {
+			dumps++
+			slow = -50 // next dump at least a minute later
+			nxTrace("main loop under 5 fps for 10 s (fps=%d), goroutines:", fps)
+			pprof.Lookup("goroutine").WriteTo(os.Stderr, 2)
+		}
+	}
+}
