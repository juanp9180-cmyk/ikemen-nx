+// Logs the Go heap every 10 s: the Go heap is capped (see horizon.c), so
+// running out of it is the usual crash with big games. "-nxpreloadall" in
+// args.txt queues every character and stage preload, like a long stay on
+// the select screen, to reproduce that in the emulator.
+func nxMemLogger() {
+	preloadAll := false
+	for _, a := range os.Args {
+		preloadAll = preloadAll || a == "-nxpreloadall"
+	}
+	var ms runtime.MemStats
+	queued := false
+	profile := ""
+	for _, a := range os.Args {
+		if a == "-nxheapprofile" {
+			profile = "1"
+			runtime.MemProfileRate = 64 << 10
+		}
+	}
+	for i := 0; ; i++ {
+		time.Sleep(time.Second)
+		if preloadAll && !queued && i >= 15 && len(sys.sel.charlist) > 0 && len(sys.sel.stagelist) > 0 {
+			queued = true
+			fmt.Fprintf(os.Stderr, "nx: preloading %d chars, %d stages\n", len(sys.sel.charlist), len(sys.sel.stagelist))
+			for r := range sys.sel.charlist {
+				sys.sel.QueueCharPreload(r, PreloadPriorityLow)
+			}
+			for r := 1; r <= len(sys.sel.stagelist); r++ {
+				sys.sel.QueueStagePreload(r, PreloadPriorityLow)
+			}
+		}
+		if i%10 == 0 {
+			runtime.ReadMemStats(&ms)
+			if profile != "" && ms.HeapAlloc > 450<<20 {
+				if f, err := os.Create(sys.baseDir + "/heap.pprof"); err == nil {
+					pprof.WriteHeapProfile(f)
+					f.Close()
+					fmt.Fprintln(os.Stderr, "nx: heap.pprof written")
+				}
+				profile = ""
+			}
+			fmt.Fprintf(os.Stderr, "nx mem: heap=%d MB sys=%d MB gc=%d\n", ms.HeapAlloc>>20, ms.Sys>>20, ms.NumGC)
+		}
+	}
+}
+
 // Log writer implementation. Stderr is copied to go_stdout.log next to the
 // executable by the Horizon runtime layer.
 func NewLogWriter() io.Writer {
@@ -95,3 +166,87 @@ func selectRenderer(cfgVal string) (Renderer, FontRenderer) {
 func Logcat(s string) {
 	fmt.Println(s)
